NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# ── URLs (Codespace) ────────────────────────────────────────────────────────
APP_URL=https://supreme-telegram-6v6pw6w79jghx74-4000.app.github.dev
WEB_URL=https://supreme-telegram-6v6pw6w79jghx74-3000.app.github.dev
CORS_ORIGINS=https://supreme-telegram-6v6pw6w79jghx74-3000.app.github.dev,http://localhost:3000,http://127.0.0.1:3000

# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# FIX for: prisma:error Error in PostgreSQL connection: Error { kind: Closed }
#
# 1) Use Neon **pooled** connection string (hostname contains `-pooler`)
# 2) Query string MUST include:
#      sslmode=require&pgbouncer=true&connection_limit=1
# 3) REMOVE channel_binding=require (breaks Prisma → kind: Closed)
#
# Copy from https://console.neon.tech → Connection details → Pooled
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
#
# Local docker-compose alternative:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://supreme-telegram-6v6pw6w79jghx74-4000.app.github.dev/api/v1/auth/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend transactional email
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM="VYQOUR <noreply@vyqour.com>"

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

SENTRY_DSN=

ADMIN_EMAIL=admin@vyqour.com
ADMIN_PASSWORD=set_a_strong_admin_password

QIKINK_ENABLED=false
QIKINK_SANDBOX=true
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=your_qikink_client_secret
QIKINK_SANDBOX_SECRET=your_qikink_sandbox_secret
QIKINK_BASE_URL=
QIKINK_SHIPPING=1
QIKINK_WEBHOOK_SECRET=your_qikink_webhook_secret
QIKINK_AUTO_SUBMIT=true
QIKINK_MAX_ATTEMPTS=8
QIKINK_WORKER_INTERVAL_MS=15000
QIKINK_STATUS_POLL_ENABLED=true
QIKINK_STATUS_POLL_CRON=*/30 * * * *
QIKINK_STATUS_ENDPOINT=/api/order/status
QIKINK_PRODUCTS_ENDPOINT=/api/products
