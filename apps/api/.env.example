NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL) — Neon / Supabase / local
DATABASE_URL=postgresql://neondb_owner:npg_7wAGDSZQC9cr@ep-royal-bar-av3fa065-pooler.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VYQOUR <noreply@vyqour.com>"

# Payments (Razorpay ready)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Sentry
SENTRY_DSN=

# Admin seed
ADMIN_EMAIL=admin@vyqour.com
ADMIN_PASSWORD=VyqourAdmin@2026

# Qikink Print-on-Demand (https://documenter.getpostman.com/view/26157218/2sB3QKqpma)
QIKINK_ENABLED=false
QIKINK_SANDBOX=true
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
QIKINK_SANDBOX_SECRET=
QIKINK_BASE_URL=
# Optional override; defaults: sandbox.qikink.com / api.qikink.com
QIKINK_SHIPPING=1
QIKINK_WEBHOOK_SECRET=
# Shared secret for inbound Qikink/status webhooks (X-Qikink-Signature HMAC-SHA256)
QIKINK_AUTO_SUBMIT=true
QIKINK_MAX_ATTEMPTS=8
QIKINK_WORKER_INTERVAL_MS=15000
QIKINK_STATUS_POLL_ENABLED=true
QIKINK_STATUS_POLL_CRON=*/30 * * * *
# Qikink public docs only document order create. Status polling uses optional
# GET /api/order/status if enabled for your account; otherwise rely on webhooks.
QIKINK_STATUS_ENDPOINT=/api/order/status
QIKINK_PRODUCTS_ENDPOINT=/api/products
