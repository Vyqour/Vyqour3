# ── GitHub Codespace ────────────────────────────────────────────────────────
# Frontend public URL (this site):
#   https://supreme-telegram-6v6pw6w79jghx74-3000.app.github.dev
#
# Browser API calls use SAME-ORIGIN /api/v1 (Next.js rewrite → Nest on :4000).
# Do NOT point NEXT_PUBLIC_API_URL at the -4000 tunnel for browser login.
#
# Copy:
#   cp apps/web/.env.example apps/web/.env.local
# Restart Next after changes. Nest MUST be running on port 4000.

# Same-origin base used by the browser client (recommended)
NEXT_PUBLIC_API_URL=/api/v1

# Nest internal target for next.config rewrites + server-side fetch
INTERNAL_API_URL=http://127.0.0.1:4000

# Public site URL (OAuth redirects, absolute links)
NEXT_PUBLIC_SITE_URL=https://supreme-telegram-6v6pw6w79jghx74-3000.app.github.dev

# Local alternative:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SITE_NAME=VYQOUR
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_RAZORPAY_KEY=
