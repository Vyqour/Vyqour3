# Browser-facing API base (include /api/v1 prefix).
# Local:
#   NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# GitHub Codespaces (use the forwarded HTTPS URL for port 4000):
#   NEXT_PUBLIC_API_URL=https://<codespace-name>-4000.app.github.dev/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Site URL used for absolute links / OAuth return.
# Codespaces: https://<codespace-name>-3000.app.github.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=VYQOUR
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_RAZORPAY_KEY=
